FROM node:22.16.0-bookworm-slim AS builder

ENV LANG=C.UTF-8 \
    NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    libvips-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . /app

# FORCE: Final stabilization for Sharp 0.33+ on Debian
RUN cd /app/bundle/programs/server \
    && rm -rf node_modules \
    && npm install --omit=dev \
    && npm install --os=linux --cpu=x64 sharp

FROM node:22.16.0-bookworm-slim

LABEL maintainer="buildmaster@rocket.chat"

ENV LANG=C.UTF-8 \
    DEPLOY_METHOD=docker \
    NODE_ENV=production \
    MONGO_URL=mongodb://mongo:27017/rocketchat \
    HOME=/tmp \
    PORT=3000 \
    ROOT_URL=http://localhost:3000 \
    Accounts_AvatarStorePath=/app/uploads

# Create rocketchat user on Debian
RUN groupmod -n rocketchat nogroup 2>/dev/null || groupadd -r rocketchat \
    && useradd -r -u 65533 -g rocketchat rocketchat \
    && mkdir -p /app/uploads \
    && chown rocketchat:rocketchat /app/uploads \
    && apt-get update && apt-get install -y --no-install-recommends \
    fontconfig \
    libvips42 \
    && rm -rf /var/lib/apt/lists/*

USER rocketchat

COPY --from=builder --chown=rocketchat:rocketchat /app /app

VOLUME /app/uploads

WORKDIR /app/bundle

EXPOSE 3000

CMD ["node", "main.js"]
